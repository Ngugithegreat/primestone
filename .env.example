# ---------------------------------------------------------------------------
# PrimeStone backend environment
# Copy to .env.local for local dev, and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.
# NEVER commit real values. .env* is gitignored.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase, RDS…).
# For Neon/Supabase use the POOLED connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Salt used to hash ID numbers for de-duplication. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KYC_HASH_SALT="change-me-to-a-long-random-string"

# --- KYC document storage (Vercel Blob) ------------------------------------
# Create a Blob store in the Vercel dashboard; it provides this token.
BLOB_READ_WRITE_TOKEN=""

# --- M-Pesa (Safaricom Daraja) ---------------------------------------------
# Start with the SANDBOX values; switch to production after go-live approval.
MPESA_ENVIRONMENT="sandbox"          # "sandbox" | "production"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"             # sandbox paybill
MPESA_PASSKEY=""                     # Lipa na M-Pesa Online passkey
MPESA_CALLBACK_URL="https://your-domain.com/api/payments/mpesa/callback"

# --- Email (Resend) — welcome email + password reset -----------------------
# Sign up at resend.com (free), create an API key, verify your sending domain.
RESEND_API_KEY=""
# Verified sender. Use onboarding@resend.dev to TEST (only reaches your own
# Resend account email) until your domain is verified.
EMAIL_FROM="PrimeStone <noreply@primestonemarkets.com>"
# Public site origin used in email links (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://primestonemarkets.com"

# --- Admin console ---------------------------------------------------------
ADMIN_PASSWORD=""                    # required to log into /admin (no default)
# Optional Cloudflare Turnstile ("verify you are human") on admin login.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
